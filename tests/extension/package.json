{
  "name": "fake-news-extension-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "rootDir": "../..",
    "testMatch": ["<rootDir>/tests/extension/*.test.js"],
    "setupFiles": ["<rootDir>/tests/extension/jest.setup.js"],
    "transform": {
      "^.+\\.js$": ["babel-jest", {
        "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]]
      }]
    },
    "moduleFileExtensions": ["js"],
    "moduleDirectories": ["node_modules", "<rootDir>/tests/extension/node_modules"]
  }
}
